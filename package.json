{
  "name": "smarthome-integrado",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "start": "node backend/src/server.mjs",
    "db:migrate": "node backend/src/migrate.mjs",
    "db:seed": "node backend/src/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test backend/tests/*.test.mjs",
    "build": "npm --prefix frontend run build",
    "install:frontend": "npm --prefix frontend install"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
