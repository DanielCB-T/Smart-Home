# Copiar a .env antes de ejecutar: cp .env.example .env

# Backend (FastAPI)
SMART_HOME_DB=/app/data/smarthome.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite): dirección de la API vista desde el contenedor del frontend
VITE_API_PROXY=http://backend:3001

# Puertos publicados en tu computadora
BACKEND_PORT=3001
FRONTEND_PORT=5173
MAILPIT_WEB_PORT=8025
